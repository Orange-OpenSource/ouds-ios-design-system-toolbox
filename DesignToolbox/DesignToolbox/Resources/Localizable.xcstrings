    "app_components_button_description_text" : {
      "comment" : "Component - Link",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الزر هو عنصر من عناصر واجهة المستخدم يقوم بتشغيل إجراء أو حدث، ويستخدم لبدء المهام أو تأكيد إجراء ما."
