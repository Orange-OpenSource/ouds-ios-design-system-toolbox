    "app_components_switch_description_text" : {
      "comment" : "Component - Switch",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المفتاح هو عنصر واجهة مستخدم يسمح بالتبديل بين حالتين، عادةً \"تشغيل\" و \"إيقاف\"، ويستخدم لتمكين أو تعطيل الميزات أو الخيارات أو الإعدادات."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Switch is a UI element that allows to toggle between two states, typically “On” and “Off”, and used to enable or disable features, options or settings."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un interrupteur est un élément d'interface utilisateur qui permet de basculer entre deux états, généralement « Marche » et « Arrêt », et qui sert à activer ou désactiver des fonctionnalités, des options ou des paramètres."
          }
        }
      }
    },
    "app_components_switch_hint_a11y" : {
      "comment" : "Component - Switch",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذه تلميح زائف لتطبيق صندوق أدوات نظام التصميم"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is a fake hint for the design system toolbox app"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ceci est un conseil bidon pour l’app de démo du design system"
          }
        }
      }
    },
    "app_components_switch_switch_description_text" : {
      "comment" : "Component - Switch",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المفتاح هو عنصر واجهة مستخدم يسمح بالتبديل بين حالتين، عادةً \"تشغيل\" و\"إيقاف\"، ويُستخدم لتمكين أو تعطيل الميزات أو الخيارات أو الإعدادات. يوفر المفتاح الذي لا يعرض أيقونة أو نصًا مرونة أكبر عند إنشاء مكونات أخرى تتطلب عرض المفتاح."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Switch is a UI element that allows to toggle between two states, typically \"On\" and \"Off\", and used to enable or disable features, options or settings. Switch that does not show icon or text, provides greater flexibility when creating other components that require a Switch to be displayed."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un interrupteur est un élément d'interface utilisateur permettant de basculer entre deux états, généralement « Activé » et « Désactivé », et servant à activer ou désactiver des fonctionnalités, des options ou des paramètres. Un interrupteur sans icône ni texte offre une plus grande flexibilité lors de la création d'autres composants nécessitant son affichage."
          }
        }
      }
    },
    "app_components_switch_switch_tech" : {
      "comment" : "Component - Switch",
      "extractionState" : "manual",
      "localizations" : {
