    },
    "app_components_switch_switchItem_description_text" : {
      "comment" : "Component - Switch",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُتيح لك مفتاح التبديل المُحسّن التبديل بين حالتين، عادةً \"تشغيل\" و\"إيقاف\"، ويُستخدم لتمكين أو تعطيل الميزات أو الخيارات أو الإعدادات. كما يُغطي هذا العنصر نطاقًا أوسع من السياقات، حيث يُتيح لك أيضًا إدارة عرض تسميات نصية وأيقونات إضافية."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Switch item is a UI element that allows to toggle between two states, typically \"On\" and \"Off\", and used to enable or disable features, options or settings. Switch Item covers a wider range of contexts by allowing to toggle the visibility of additional text labels and icon assets."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un interrupteur enrichi permet de basculer entre deux états, généralement « Activé » et « Désactivé », et sert à activer ou désactiver des fonctionnalités, des options ou des paramètres. Cet élément couvre un plus large éventail de contextes en permettant également de gérer l'affichage d'étiquettes textuelles et d'icônes supplémentaires."
          }
        }
      }
    },
    "app_components_switch_switchItem_tech" : {
