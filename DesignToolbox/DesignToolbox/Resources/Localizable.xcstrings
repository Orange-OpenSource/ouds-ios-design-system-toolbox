    "app_components_divider_verticalDivider_description_text" : {
      "comment" : "Component - Divider",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم استخدام الفاصل الرأسي لفصل المحتوى الموضوع جنبًا إلى جنب"
          }
        },
