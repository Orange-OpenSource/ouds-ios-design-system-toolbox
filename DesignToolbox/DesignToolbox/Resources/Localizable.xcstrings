        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن أن تساعد Opacity في تمييز عناصر المقدمة عن عناصر الخلفية، مما يجعل المحتوى أسهل في القراءة ويجعل الإجراءات المهمة أكثر وضوحًا."
          }
        },
