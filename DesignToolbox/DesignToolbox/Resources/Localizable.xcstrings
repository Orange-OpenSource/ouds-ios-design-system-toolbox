    "app_components_checkbox_checkbox_description_text" : {
      "comment" : "Component - Checkbox",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مربع الاختيار هو عنصر واجهة مستخدم يسمح بتحديد خيارات متعددة من مجموعة خيارات غير حصرية. يوفر مربع الاختيار الذي لا يعرض أيقونة أو نصًا مرونة أكبر عند إنشاء مكونات أخرى تتطلب عرض مربع اختيار."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Checkbox is a UI element that allows to select multiple options from a set of mutually non exclusive choices. Checkbox that does not show icon or text, provides greater flexibility when creating other components that require a checkbox to be displayed. "
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La case à cocher est un élément d'interface utilisateur permettant de sélectionner plusieurs options parmi un ensemble de choix non exclusifs. Une case à cocher sans icône ni texte offre une plus grande flexibilité lors de la création d'autres composants nécessitant son affichage."
          }
        }
      }
    },
    "app_components_checkbox_checkbox_tech" : {
      "comment" : "Component - Checkbox",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Checkbox"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Checkbox"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Checkbox"
          }
        }
      },
      "shouldTranslate" : false
    },
    "app_components_checkbox_checkboxItem_description_text" : {
      "comment" : "Component - Checkbox",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مربع الاختيار المتقدم هو عنصر في واجهة المستخدم يتيح لك تحديد خيارات متعددة من مجموعة خيارات غير حصرية. يغطي مربع الاختيار المتقدم نطاقًا أوسع من السياقات من خلال السماح لك بتفعيل/إيقاف ظهور تسميات نصية وأيقونات إضافية."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Checkbox item is a UI element that allows to select multiple options from a set of mutually non exclusive choices. Checkbox item covers a wider range of contexts by allowing to toggle the visibility of additional text labels and icon assets."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La case à cocher enrichie est un élément d'interface utilisateur qui permet de sélectionner plusieurs options parmi un ensemble de choix mutuellement non exclusifs. La case à cocher enriche couvre un plus large éventail de contextes en permettant de basculer la visibilité d’étiquettes de texte et d’icônes supplémentaires."
          }
        }
      }
    },
    "app_components_checkbox_checkboxItem_tech" : {
