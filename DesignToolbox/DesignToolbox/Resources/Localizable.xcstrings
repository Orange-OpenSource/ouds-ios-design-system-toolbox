    "app_components_textInput_description_text" : {
      "comment" : "Component - Text Input",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إدخال النص هو عنصر من عناصر واجهة المستخدم يسمح بكتابة أو تحرير أو تحديد سطر واحد من البيانات النصية، مثل الأسماء أو عناوين البريد الإلكتروني أو استعلامات البحث."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Text input is a UI element that allows to type, edit, or select single line of textual data, such as names, emails or search queries."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le champ de saisie de texte est un élément d'interface utilisateur qui permet de saisir, de modifier ou de sélectionner une seule ligne de données textuelles, telles que des noms, des adresses électroniques ou des requêtes de recherche."
          }
        }
      }
    },
