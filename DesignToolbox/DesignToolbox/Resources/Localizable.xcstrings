    "app_components_radioButton_description_text" : {
      "comment" : "Component - Radio",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "زر الاختيار هو عنصر من عناصر واجهة المستخدم يسمح بتحديد خيار واحد من مجموعة من الخيارات الحصرية المتبادلة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radio button is a UI element that allows to select a single option from a set of mutually exclusive choices."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le bouton radio est un élément de l'interface utilisateur qui permet de sélectionner une seule option parmi un ensemble de choix mutuellement exclusifs."
          }
        }
      }
    },
    "app_components_radioButton_hint_a11y" : {
      "comment" : "Component - Radio",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذه تسمية زائفة لتطبيق صندوق أدوات نظام التصميم"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is a fake label for the design system toolbox app"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ceci est un label bidon pour l’app de démo du design system"
          }
        }
      }
    },
    "app_components_radioButton_radioButton_description_text" : {
      "comment" : "Component - Radio",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "زر الاختيار هو عنصر في واجهة المستخدم يسمح باختيار خيار واحد من بين مجموعة من الخيارات الحصرية. يوفر زر الاختيار الذي لا يعرض أيقونة أو نصًا مرونة أكبر عند إنشاء مكونات أخرى تتطلب عرض زر اختيار."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radio button is a UI element that allows to select a single option from a set of mutually exclusive choices. Radio button that does not show icon or text, provides greater flexibility when creating other components that require a Radio button to be displayed."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le bouton radio est un élément de l'interface utilisateur qui permet de sélectionner une seule option parmi un ensemble de choix mutuellement exclusifs. Le bouton radio qui n'affiche pas d'icône ou de texte offre une plus grande flexibilité lors de la création d'autres composants nécessitant l'affichage d'un bouton radio."
          }
        }
      }
    },
    "app_components_radioButton_radioButton_tech" : {
      "comment" : "Component - Radio",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radio button"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radio button"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radio button"
          }
        }
      },
      "shouldTranslate" : false
    },
    "app_components_radioButton_radioButtonItem_description_text" : {
      "comment" : "Component - Radio",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "زر الاختيار المتقدم هو عنصر في واجهة المستخدم يتيح لك اختيار خيار واحد من بين مجموعة من الخيارات الحصرية. يغطي زر الاختيار المتقدم نطاقًا أوسع من السياقات من خلال السماح لك بتفعيل/إيقاف ظهور النصوص والأيقونات الإضافية."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radio button Item is a UI element that allows to select a single option from a set of mutually exclusive choices. Radio button Item covers a wider range of contexts by allowing to toggle the visibility of additional text labels and icon assets."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le bouton radio enrichi est un élément d'interface utilisateur qui permet de sélectionner une seule option parmi un ensemble de choix mutuellement exclusifs. Le bouton radio enrichi couvre un plus large éventail de contextes en permettant de basculer la visibilité des étiquettes de texte et des icônes supplémentaires."
          }
        }
      }
    },
    "app_components_radioButton_radioButtonItem_tech" : {
