    "app_components_tag_description_text" : {
      "comment" : "Component - Tag",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الوسم هو عنصر من عناصر واجهة المستخدم يعرض معلومات قصيرة مثل التسمية أو الكلمة الرئيسية أو الفئة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tag is a UI element that displays short information such as a label, a keyword or a category."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une étiquette est un élément d'interface utilisateur qui affiche de courtes informations telles qu'un libellé, un mot-clé ou une catégorie."
          }
        }
      }
    },
    "app_components_tag_inputTag_description_text" : {
      "comment" : "Component - Input Tag",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حقل الإدخال هو عنصر في واجهة المستخدم يسمح للمستخدمين بإدخال قيم متعددة، كل قيمة ممثلة بتسمية. عند إدخال المستخدم للقيم وتأكيدها (عادةً بالضغط على مفتاح الإدخال أو الفاصلة أو مفتاح الجدولة)، تُحوّل كل قيمة إلى تسمية. تُستخدم حقول الإدخال غالبًا لإضافة تسميات أو فئات أو مشاركين."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Input tag is a UI element that allows to enter multiple values, each represented as a tag. As users type and submit values (usually by pressing enter, comma, or tab), each value is transformed into a tag. Input tag is often used for adding labels, categories, or participants."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’étiquette de saisie est un élément d'interface utilisateur permettant de saisir plusieurs valeurs, chacune étant représentée par une étiquette. Lorsque l'utilisateur saisit et valide des valeurs (généralement en appuyant sur Entrée, virgule ou tabulation), chaque valeur est transformée en une étiquette. Le champ de saisie est souvent utilisé pour ajouter des libellés, des catégories ou des participants."
          }
        }
      }
    },
    "app_components_tag_inputTag_tech" : {
      "comment" : "Component - InputTag",
      "extractionState" : "manual",
