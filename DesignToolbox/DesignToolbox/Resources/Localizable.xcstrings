    "app_components_link_description_text" : {
      "comment" : "Component - Link",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الرابط هو عنصر واجهة مستخدم يسمح بالانتقال من مكان إلى آخر، سواء داخل نفس الصفحة أو عبر صفحات مختلفة في نفس المورد، أو إلى مورد خارجي."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Link is a UI element that allows to navigate from one location to another, either within the same page or across different pages in the same resource, or to an external resource."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un lien est un élément d'interface utilisateur qui permet de naviguer d'un emplacement à un autre, que ce soit au sein de la même page, entre différentes pages de la même ressource ou vers une ressource externe."
          }
        }
      }
    },
