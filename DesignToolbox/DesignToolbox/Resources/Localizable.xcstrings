        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App bar هو مكون موجه من الأعلى يعرض عنوان الشاشة ويوفر الوصول إلى الإجراءات الرئيسية وعناصر التنقل."
