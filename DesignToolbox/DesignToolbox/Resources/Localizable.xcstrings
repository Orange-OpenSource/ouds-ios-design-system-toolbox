    "app_components_listItem_contentConfiguration_label" : {
      "comment" : "Component - List Item",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المحتوى"
          }
        },
        "en" : {
