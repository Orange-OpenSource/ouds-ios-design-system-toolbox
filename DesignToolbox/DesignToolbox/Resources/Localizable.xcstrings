    "app_components_chip_description_text" : {
      "comment" : "Component - Chip",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تساعد Chips   المستخدمين على إدخال المعلومات، القيام باختيارات، تصفية المحتوى، أو تنفيذ إجراءات."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chips help people enter information, make selections, filter content, or trigger actions."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les Chips aident les utilisateurs à saisir des informations, à effectuer des sélections, à filtrer le contenu ou à déclencher des actions."
          }
        }
      }
    },
    "app_components_chip_filterChip_chipContent_label" : {
      "comment" : "Component - Chip",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فلتر"
          }
