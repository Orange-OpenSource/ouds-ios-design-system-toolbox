    "app_components_chip_filterChip_description_text" : {
      "comment" : "Component - Chip",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شريحة التصفية هي عنصر من عناصر واجهة المستخدم يسمح بتحديد أو إلغاء تحديد خيار ضمن سلسلة، وتستخدم عادة لالتقاط قرارات التصفية."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filter chip is a UI element that allows to select or deselect an option within a series, and is commonly used to capture filtering decisions."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le filtre est un élément d'interface utilisateur qui permet de sélectionner ou de désélectionner une option au sein d'une série, et est couramment utilisé pour enregistrer les décisions de filtrage."
          }
        }
      }
    },
    "app_components_chip_filterChip_tech" : {
