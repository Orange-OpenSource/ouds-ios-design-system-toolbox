      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " يتيح  Radio picker للمستخدمين اختيار عنصر واحد من مجموعة من أزرار الراديو."
