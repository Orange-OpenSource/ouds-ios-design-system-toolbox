    "app_components_tag_tag_description_text" : {
      "comment" : "Component - Tag",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الوسم هو عنصر من عناصر واجهة المستخدم يسمح بعرض معلومات مختصرة مثل التسمية أو الكلمة المفتاحية أو الفئة. يساعد الوسم المستخدمين على إيجاد المحتوى وتصنيفه وفهمه بسرعة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tag is a UI element that allows to display short info like a label, keyword, or category. Tag helps users quickly find, group, or understand content."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une étiquette est un élément d'interface utilisateur permettant d'afficher des informations concises telles qu'un libellé, un mot-clé ou une catégorie. Elle aide les utilisateurs à trouver, regrouper ou comprendre rapidement du contenu."
          }
        }
      }
    },
