    "app_components_coloredBackground_description_text" : {
      "comment" : "Component - Colored Surface",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تستخدم الخلفيات الملونة ألوانًا سطحية لزيادة التباين مع المحتوى. وتكيف العديد من العناصر، مثل الأزرار والروابط، طريقة عرضها عند عرضها على خلفيات ملونة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colored backgrounds use surface colors to maximize the contrast with content. Several components such as buttons or links adapt their display accordingly when they are displayed on colored backgrounds."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le composant ColoredSurface utilisent des couleurs de surface pour maximiser le contraste avec le contenu. Plusieurs composants, tels que les boutons ou les liens, adaptent leur affichage en conséquence lorsqu'ils sont affichés sur des arrière-plans colorés."
          }
        }
      }
    },
