    "app_components_textArea_description_text" : {
      "comment" : "Component - Text Area",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "منطقة النص هي عنصر من عناصر واجهة المستخدم يسمح بكتابة أو تحرير أو تحديد كتل نصية متعددة الأسطر، مثل التعليقات أو الرسائل أو الأوصاف."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Text area is a UI element that allows to type, edit, or select multiple lines of textual data, such as comments, messages or descriptions."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La zone de texte est un élément d'interface utilisateur qui permet de saisir, de modifier ou de sélectionner plusieurs lignes de données textuelles, telles que des commentaires, des messages ou des descriptions."
          }
        }
