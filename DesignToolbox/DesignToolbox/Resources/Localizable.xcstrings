    "app_components_listItem_navigation_description" : {
      "comment" : "Component - List Item",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عنصر قائمة التنقل يشبه عنصر القائمة الثابتة، ولكنه يستطيع إعادة توجيه المستخدمين إلى مكان آخر باستخدام التنقل."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A navigation list item is like a static list item but can redirect users elsewhere with navigation"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un liste item de navigation est similaire à un élément de liste statique, mais peut rediriger les utilisateurs vers d'autres emplacements grâce à la navigation."
