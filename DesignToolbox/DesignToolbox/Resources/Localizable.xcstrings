    "app_components_listItem_static_description" : {
      "comment" : "Component - List Item",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "القائمة الثابتة هي عنصر من عناصر واجهة المستخدم لا يمكن النقر عليه وعرض محتواه دون مزيد من التنقل."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Static list is a UI element which cannot be clicked and display content without further navigation."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un liste item statique est un élément d'interface utilisateur qui ne peut être cliqué et afficher son contenu sans navigation supplémentaire."
          }
        }
      }
