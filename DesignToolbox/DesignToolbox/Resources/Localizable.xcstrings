    "app_components_bottomAppBar_description_text" : {
      "comment" : "Component - Tool bar Bottom",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يوفر شريط الأدوات السفلي وصولاً سهلاً إلى الأوامر وعناصر التحكم والبحث المستخدمة بشكل متكرر."
