    "app_components_checkbox_description_text" : {
      "comment" : "Component - Checkbox",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مربع الاختيار هو عنصر من عناصر واجهة المستخدم يسمح بتحديد خيارات متعددة من مجموعة من الخيارات غير الحصرية المتبادلة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Checkbox is a UI element that allows to select multiple options from a set of mutually non exclusive choices."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La case à cocher est un élément de l'interface utilisateur qui permet de sélectionner plusieurs options parmi un ensemble de choix mutuellement non exclusifs."
          }
