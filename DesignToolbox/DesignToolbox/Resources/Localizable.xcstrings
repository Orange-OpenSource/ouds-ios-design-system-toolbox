    "app_components_chip_suggestionChip_description_text" : {
      "comment" : "Component - Chip",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شريحة الاقتراحات هي عنصر من عناصر واجهة المستخدم يسمح بعرض خيارات موصى بها أو تنبؤية بناءً على مدخلات المستخدم أو السياق، وتستخدم عادة لالتقاط قرارات التصفية."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suggestion chip is a UI element that allows to present recommended or predictive options based on user’s input or context, and is commonly used to capture filtering decisions."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La puce de suggestion est un élément d'interface utilisateur qui permet de présenter des options recommandées ou prédictives en fonction des entrées ou du contexte de l'utilisateur, et est couramment utilisée pour capturer les décisions de filtrage."
          }
        }
      }
    },
